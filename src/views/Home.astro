---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import StoreButton from '../components/StoreButton.astro';
import Wordmark from '../components/Wordmark.astro';
import icon from '../assets/icon.png';
import { PRICES } from '../consts';
import { euros, path, ui, type Lang } from '../i18n/ui';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

// App Store screenshots, if any: src/assets/shots/<lang>/01-….png, 02-….png… (none yet).
const allShots = import.meta.glob<{ default: ImageMetadata }>('../assets/shots/*/*.png', { eager: true });
const shots = Object.entries(allShots)
	.filter(([file]) => file.includes(`/shots/${lang}/`))
	.sort(([a], [b]) => a.localeCompare(b))
	.map(([, mod], i) => ({ src: mod.default, alt: t.shots[i] ?? '' }));

const plans = [
	{
		name: t.pro.yearly,
		price: euros(PRICES.yearly, lang),
		unit: t.pro.perYear,
		note: t.pro.trial(PRICES.trialDays),
		featured: true,
	},
	{
		name: t.pro.lifetime,
		price: euros(PRICES.lifetime, lang),
		unit: '',
		note: PRICES.lifetimeRegular ? t.pro.launch(euros(PRICES.lifetimeRegular, lang)) : t.pro.once,
	},
];
---

<Base lang={lang} slug="">
	<section class="hero">
		<div class="wrap hero-grid">
			<div class="hero-copy">
				<p class="kicker">{t.hero.kicker}</p>
				<h1 class="display">{t.hero.title}</h1>
				<p class="lead">{t.hero.lead}</p>
				<StoreButton lang={lang} />
				<p class="note">{t.hero.note}</p>
			</div>
			<div class="hero-shot">
				{
					shots[0] ? (
						<Image src={shots[0].src} alt={shots[0].alt} width={420} densities={[1, 2]} loading="eager" class="shot" />
					) : (
						<div class="hero-mark">
							<Image src={icon} alt="" width={220} height={220} densities={[1, 2]} loading="eager" class="hero-icon" />
							<Wordmark />
						</div>
					)
				}
			</div>
		</div>
	</section>

	{
		shots.length > 1 && (
			<section class="gallery" aria-label={t.nav.systems}>
				<div class="gallery-track">
					{shots.slice(1).map((s) => (
						<figure>
							<Image src={s.src} alt={s.alt} width={300} densities={[1, 2]} class="shot" />
						</figure>
					))}
				</div>
			</section>
		)
	}

	<section id="season" class="section">
		<div class="wrap">
			<h2 class="display section-title">{t.season.title}</h2>
			<p class="lead center">{t.season.lead}</p>
			<ol class="phases">
				{
					t.season.phases.map((p, i) => (
						<li class:list={['card', 'phase', { 'phase-season': i === 1 }]}>
							<p class="eyebrow">{p.when}</p>
							<h3>{p.name}</h3>
							<p>{p.text}</p>
						</li>
					))
				}
			</ol>
			<p class="status-line">
				<span class="dot dot-overdue" aria-hidden="true"></span><span class="dot dot-soon" aria-hidden="true"></span><span class="dot dot-ok" aria-hidden="true"></span><span class="dot dot-none" aria-hidden="true"></span>
				{t.season.note}
			</p>
		</div>
	</section>

	<section id="systems" class="section section-alt">
		<div class="wrap">
			<h2 class="display section-title">{t.systems.title}</h2>
			<p class="lead center">{t.systems.lead}</p>
			<ul class="systems">
				{
					t.systems.list.map((s, i) => (
						<li class="card system">
							<span class="system-num" aria-hidden="true">{i + 1}</span>
							<h3>{s.name}</h3>
							<p>{s.examples}</p>
						</li>
					))
				}
			</ul>
			<p class="fine">{t.systems.note}</p>
		</div>
	</section>

	<section id="features" class="section">
		<div class="wrap">
			<h2 class="display section-title">{t.featuresTitle}</h2>
			<div class="features">
				{
					t.features.map((f) => (
						<article class="card feature">
							<h3>{f.title}</h3>
							<ul>
								{f.items.map((item) => (
									<li>{item}</li>
								))}
							</ul>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="section privacy-band">
		<div class="wrap privacy-grid">
			<div>
				<h2 class="display">{t.privacy.title}</h2>
				<p class="lead">{t.privacy.lead}</p>
				<a class="text-link" href={path(lang, 'privacy')}>{t.privacy.link} →</a>
			</div>
			<ul class="checks">
				{t.privacy.points.map((p) => <li>{p}</li>)}
			</ul>
		</div>
	</section>

	<section id="pro" class="section">
		<div class="wrap">
			<h2 class="display section-title">{t.pro.title}</h2>
			<p class="lead center">{t.pro.lead}</p>
			<div class="pro-grid">
				<article class="card tier">
					<h3>{t.pro.free}</h3>
					<p class="price">{euros(0, lang)}</p>
					<ul class="checks small">{t.pro.freeItems.map((i) => <li>{i}</li>)}</ul>
				</article>
				<article class="card tier tier-pro">
					<h3>Pro <span class="pro-badge">PRO</span></h3>
					<ul class="checks small">{t.pro.items.map((i) => <li>{i}</li>)}</ul>
				</article>
			</div>
			<div class="plans">
				{
					plans.map((p) => (
						<div class:list={['card', 'plan', { featured: p.featured }]}>
							<p class="plan-name">{p.name}</p>
							<p class="price">
								{p.price} <span>{p.unit}</span>
							</p>
							<p class="muted">{p.note}</p>
						</div>
					))
				}
			</div>
			<p class="fine">{t.pro.fine}</p>
			<div class="center"><StoreButton lang={lang} /></div>
		</div>
	</section>
</Base>
