---
import '../styles/global.css';
import { APP_STORE_ID, CONTACT_EMAIL, OWNER, SITE_URL } from '../consts';
import { defaultLang, languages, langs, locales, path, ui, type Lang, type Slug } from '../i18n/ui';

interface Props {
	lang: Lang;
	slug: Slug;
	title?: string;
	description?: string;
	noindex?: boolean;
}

const { lang, slug, title, description, noindex = false } = Astro.props;
const t = ui[lang];
const pageTitle = title ? `${title} · Luffly` : t.meta.title;
const pageDescription = description ?? t.meta.description;
const canonical = new URL(path(lang, slug), SITE_URL).href;
const ogLocale = { en: 'en_US', es: 'es_ES', ca: 'ca_ES' }[lang];
const home = path(lang);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={locales[lang]}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<meta name="description" content={pageDescription} />
		<link rel="canonical" href={canonical} />
		{noindex && <meta name="robots" content="noindex" />}
		{
			!noindex &&
				langs.map((l) => (
					<link rel="alternate" hreflang={locales[l]} href={new URL(path(l, slug), SITE_URL).href} />
				))
		}
		{!noindex && <link rel="alternate" hreflang="x-default" href={new URL(path(defaultLang, slug), SITE_URL).href} />}
		{APP_STORE_ID && <meta name="apple-itunes-app" content={`app-id=${APP_STORE_ID}`} />}
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#F2F5F9" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#050D18" media="(prefers-color-scheme: dark)" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Luffly" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content={ogLocale} />
		<meta property="og:image" content={new URL('/og.jpg', SITE_URL).href} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="preload" href="/fonts/BigShouldersDisplay-ExtraBold.ttf" as="font" type="font/ttf" crossorigin />
		<slot name="head" />
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>
		<header class="site-header">
			<div class="wrap header-row">
				<a class="brand" href={home} aria-label="Luffly">
					<img src="/favicon.png" width="32" height="32" alt="" class="brand-icon" />
					<span class="wordmark">Luffly</span>
				</a>
				<nav class="main-nav" aria-label="Luffly">
					<a href={`${home}#season`} class="hide-sm">{t.nav.season}</a>
					<a href={`${home}#pro`} class="hide-sm">{t.nav.pro}</a>
					<a href={path(lang, 'support')} aria-current={slug === 'support' ? 'page' : undefined}>{t.nav.support}</a>
					<details class="langs">
						<summary aria-label={`${t.language}: ${languages[lang]}`}>
							<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" d="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Zm-9 9h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3Z"/></svg>
							{lang.toUpperCase()}
						</summary>
						<ul>
							{
								langs.map((l) => (
									<li>
										<a href={path(l, slug)} hreflang={locales[l]} lang={locales[l]} aria-current={l === lang ? 'true' : undefined}>
											{languages[l]}
										</a>
									</li>
								))
							}
						</ul>
					</details>
				</nav>
			</div>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="wrap footer-row">
				<div>
					<img src="/favicon.png" width="32" height="32" alt="" class="footer-icon" />
					<p class="muted">
						© {year} Luffly · {t.footer.made} {OWNER}
					</p>
				</div>
				<nav class="footer-nav" aria-label="Legal">
					<a href={path(lang, 'support')}>{t.nav.support}</a>
					<a href={path(lang, 'privacy')}>{t.nav.privacy}</a>
					<a href={path(lang, 'terms')}>{t.nav.terms}</a>
					<a href={`mailto:${CONTACT_EMAIL}?subject=Luffly`}>{t.footer.contact}</a>
				</nav>
			</div>
		</footer>
		<script>
			// Close the language menu on a click outside it or on Escape.
			const menu = document.querySelector<HTMLDetailsElement>('details.langs');
			document.addEventListener('click', (e) => {
				if (menu?.open && !menu.contains(e.target as Node)) menu.open = false;
			});
			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape' && menu?.open) {
					menu.open = false;
					menu.querySelector('summary')?.focus();
				}
			});
		</script>
	</body>
</html>
